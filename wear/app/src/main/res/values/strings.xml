    <string name="advice_recover_duration_fatigue">Nghỉ 5–10 phút; phiên sau đặt mốc nghỉ khoảng 35–40 phút.</string>
    <string name="advice_recover_repeated_yawn">Rời màn hình và nghỉ 10–15 phút. Chỉ quay lại học khi cảm thấy tỉnh táo.</string>
    <string name="advice_complete_current_break">Bạn đã bắt đầu nghỉ — hãy hoàn tất phần nghỉ hiện tại và chỉ học tiếp khi tỉnh táo hơn.</string>
    <string name="advice_move_after_immobility">Đứng dậy, đi lại hoặc giãn cơ nhẹ trong 3–5 phút.</string>
    <string name="advice_posture_head_back">Nâng tài liệu hoặc màn hình; giữ đầu và thân thẳng, lưng có điểm tựa.</string>
    <string name="advice_posture_center">Đưa màn hình về chính giữa và thả lỏng đều hai vai.</string>
    <string name="advice_posture_distance">Tăng khoảng cách tới màn hình và tăng cỡ chữ thay vì cúi sát.</string>
    <string name="advice_recheck_heart_rate">Ngồi yên khoảng 5 phút rồi đo lại nhịp tim trên đồng hồ.</string>
    <string name="advice_maintain_good">Làm tốt lắm! Chưa có rule đáng tin cậy nào báo vấn đề nổi trội; hãy tiếp tục đổi tư thế và nghỉ ngắn đều đặn.</string>
