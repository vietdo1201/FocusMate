<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/session_report_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tv_report_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#DCE8F2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_report_rule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:textColor="#8DDBFF"
            android:textSize="10sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.1"
            android:text="@string/report_priority_heading"
            android:textColor="#FFD58A"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_report_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/workload_background"
            android:lineSpacingExtra="2dp"
            android:padding="10dp"
            android:textColor="#F5F8FB"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_report_secondary_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.1"
            android:text="@string/report_secondary_heading"
            android:textColor="#A9D5FF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_report_secondary_one"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/panel_background"
            android:lineSpacingExtra="2dp"
            android:padding="9dp"
            android:textColor="#E4EDF5"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_report_secondary_two"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/panel_background"
            android:lineSpacingExtra="2dp"
            android:padding="9dp"
            android:textColor="#E4EDF5"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_report_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"
            android:textColor="#C5D2DE"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tv_report_data_quality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:lineSpacingExtra="2dp"
            android:textColor="#8496A8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tv_report_health_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/status_background"
            android:lineSpacingExtra="2dp"
            android:padding="9dp"
            android:text="@string/report_heart_rate_safety"
            android:textColor="#FFCFB3"
            android:textSize="9sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="@string/report_start_scores_note"
            android:textColor="#6F8294"
            android:textSize="8sp" />
    </LinearLayout>
</ScrollView>
