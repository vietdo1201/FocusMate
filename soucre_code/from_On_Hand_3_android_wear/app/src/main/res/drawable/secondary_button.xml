<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#101722" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="#263443" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#23384B" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="#527B9D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#162433" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="#36536B" />
        </shape>
    </item>
</selector>
