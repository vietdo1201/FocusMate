<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background">

    <ScrollView
        android:id="@+id/root_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="36dp"
            android:paddingEnd="26dp"
            android:paddingBottom="44dp">

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="#F4F8FF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="9dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_reminder_readiness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
        android:text="@string/reminder_checking"
                    android:textColor="#FFCA74"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_reminder_settings"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/secondary_button"
                    android:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
        android:text="@string/fix_settings"
                    android:textAllCaps="false"
                    android:textColor="#F1F7FC"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/hero_background"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tv_session_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.16"
                    android:text="@string/state_ready"
                    android:textColor="#78CCFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_timer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/timer_zero"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_break_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/cooldown_badge"
                    android:fontFamily="monospace"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="@string/break_timer_default"
                    android:textColor="#8DDBFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_primary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/primary_button"
                    android:backgroundTint="@null"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/start_study"
                    android:textAllCaps="false"
                    android:textColor="#06111D"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_cooldown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/cooldown_badge"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/cooldown_default"
                    android:textColor="#A9DDFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:letterSpacing="0.12"
                android:text="@string/prepare_section"
                android:textColor="#8496A8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="9dp">

                <Button
                    android:id="@+id/btn_task"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/secondary_button"
                    android:backgroundTint="@null"
                    android:contentDescription="@string/select_task_type"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:stateListAnimator="@null"
                    android:text="@string/task_exercise"
                    android:textAllCaps="false"
                    android:textColor="#F1F7FC"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_focus_minus"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/secondary_button"
                        android:backgroundTint="@null"
                        android:contentDescription="@string/decrease_focus"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="@string/minus"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tv_focus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/focus_value"
                        android:textColor="#DCE8F2"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_focus_plus"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/secondary_button"
                        android:backgroundTint="@null"
                        android:contentDescription="@string/increase_focus"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="@string/plus"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_fatigue_minus"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/secondary_button"
                        android:backgroundTint="@null"
                        android:contentDescription="@string/decrease_fatigue"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="@string/minus"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tv_fatigue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/fatigue_value"
                        android:textColor="#DCE8F2"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_fatigue_plus"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/secondary_button"
                        android:backgroundTint="@null"
                        android:contentDescription="@string/increase_fatigue"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="@string/plus"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_cancel"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/danger_button"
                    android:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/cancel_session"
                    android:textAllCaps="false"
                    android:textColor="#FFB9C0"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:letterSpacing="0.12"
                android:text="@string/insights_section"
                android:textColor="#8496A8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_session_confidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/confidence_background"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:paddingStart="10dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp"
                android:text="@string/session_confidence_idle"
                android:textColor="#78CCFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_rule_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/status_background"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:paddingStart="10dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp"
                android:text="@string/rule_status_idle"
                android:textColor="#8DDBFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_posture_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/workload_background"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:paddingStart="10dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp"
                android:text="@string/posture_status_idle"
                android:textColor="#A9D5FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_yawn_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/workload_background"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:paddingStart="10dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp"
                android:text="@string/yawn_status_idle"
                android:textColor="#FFD58A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.12"
                android:text="@string/progress_section"
                android:textColor="#8496A8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/panel_background"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingTop="10dp"
                android:paddingEnd="9dp"
                android:paddingBottom="10dp">

                <TextView
                    android:text="@string/last_seven_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#96A6B7"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_today_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/today_zero"
                    android:textColor="#78CCFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <vn.edu.uit.tpkd.wear.cogload.WeeklyStudyChart
                    android:id="@+id/weekly_chart"
                    android:layout_width="match_parent"
                    android:layout_height="108dp"
                    android:layout_marginTop="3dp"
                    android:importantForAccessibility="yes"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp" />

                <TextView
                    android:id="@+id/tv_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/stats_zero"
                    android:textColor="#C5D2DE"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_recent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/panel_background"
                android:lineSpacingExtra="2dp"
                android:padding="11dp"
                android:text="@string/history_empty_short"
                android:textColor="#C9D5DF"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.12"
                android:text="@string/posture_runtime_section"
                android:textColor="#8496A8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_posture_runtime_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/status_background"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:paddingStart="10dp"
                android:paddingTop="11dp"
                android:paddingEnd="10dp"
                android:paddingBottom="11dp"
                android:text="@string/posture_runtime_idle"
                android:textColor="#A9DFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_test_reminder"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/secondary_button"
                android:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
            android:text="@string/test_vibration"
                android:textAllCaps="false"
                android:textColor="#F1F7FC"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>
</androidx.wear.widget.BoxInsetLayout>
